# Local development: python init_env.py writes private random keys into .env.
# Never commit .env. Use the SAME keys in web and worker. Back up ENCRYPTION_KEY.
APP_ENV=development
BASE_URL=http://127.0.0.1:5000
# Optional production-only additional hostnames, comma-separated; no wildcards or URLs.
# BASE_URL's hostname is always trusted. Leave empty to trust only BASE_URL.
# During a domain move, keep the existing Railway hostname here until old links expire.
# TRUSTED_HOSTS=kubek-finance-portal-production.up.railway.app,portal.kubekfinance.sk
TRUSTED_HOSTS=
SECRET_KEY=
ENCRYPTION_KEY=

# Empty = local SQLite in instance/portal.db.
# Production: postgresql+psycopg://user:password@host:5432/portal?sslmode=require
DATABASE_URL=
RATELIMIT_STORAGE_URI=memory://
# Enable only behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Optional. No key = deterministic profile, visibly labelled without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# disabled | smtp | sendgrid
EMAIL_BACKEND=disabled
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=

ORGANIZATION_NAME="KUBEK Finance"
# Controller name and primary contact email.
CONTROLLER_NAME=
CONTROLLER_ICO=55012469
CONTROLLER_DIC=2121841821
PRIVACY_EMAIL=info@kubekfinance.sk
RETENTION_DAYS=180

# Used by Docker Compose only; generated by init_env.py.
POSTGRES_PASSWORD=
